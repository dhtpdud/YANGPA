{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "메인 창에 필요한 최소 권한: 앱 명령, 이벤트 수신, 파일 열기·저장 대화상자, 보내기 전 동영상·음성 미리보기, 휘발성 채널의 캡처·녹화 감지, OS 알림에 쓰는 지금 연 채널, 통화의 신경망 음성 코덱(모델 폴더), 화면공유 인코더(ffmpeg 폴더)·화면 소리, 처음 만든 복구 문구 복사·저장, 웹 초대 페이지가 연 링크 받기, 화면공유 보기의 전체화면(창), 데이터 폴더 바꾸기·옮기기.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-fullscreen",
    "core:app:allow-register-listener",
    "core:app:allow-remove-listener",
    "notification:allow-is-permission-granted",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-rpc-call",
    "allow-daemon-status",
    "allow-daemon-retry",
    "allow-set-content-protection",
    "allow-set-capture-watch",
    "allow-open-external",
    "allow-ui-prefs-get",
    "allow-ui-prefs-set",
    "allow-shell-texts",
    "allow-notify-set-viewing",
    "allow-local-preview-open",
    "allow-local-preview-close",
    "allow-neural-status",
    "allow-neural-encode",
    "allow-neural-decode",
    "allow-neural-close",
    "allow-screen-status",
    "allow-screen-sources",
    "allow-screen-start",
    "allow-screen-stop",
    "allow-screen-audio-start",
    "allow-screen-audio-stop",
    "allow-secret-copy",
    "allow-deep-link-take"
,
    "allow-data-dir-info",
    "allow-data-dir-plan",
    "allow-data-dir-change",
    "allow-app-restart",
    "allow-update-target",
    "allow-update-install",
    "allow-file-import",
    "allow-file-export",
    "allow-file-release",
    "allow-call-active",
    "allow-app-minimize",
    "allow-app-info"
  ]
}
