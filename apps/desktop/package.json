{
  "name": "yangpa-desktop",
  "private": true,
  "version": "1.1.1",
  "description": "양파 메신저(가칭) 데스크톱 앱 프런트엔드",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:window": "vitest run --config e2e-window/vitest.config.ts",
    "test:window:build": "npm run build && cargo build -p yangpa-daemon && cargo build -p yangpa-desktop --features yangpa-desktop/custom-protocol,yangpa-desktop/webdriver",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "tauri": "tauri",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.21",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "21.0.4",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
